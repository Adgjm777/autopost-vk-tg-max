# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env НЕ публикуется (он в .gitignore).

# --- VK ---
# ID сообщества (число, без минуса). Например: 123456789
VK_GROUP_ID=

# Токен сообщества: права wall, photos, video, messages, manage
# (Управление сообществом -> Работа с API -> Создать ключ)
VK_TOKEN=

# Пользовательский токен: нужен ТОЛЬКО для загрузки видео (video.save)
# Права: video, wall, offline. Можно оставить пустым, если публикуете только фото.
VK_USER_TOKEN=

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Канал, куда публиковать: @имя_канала (бот должен быть админом канала)
TELEGRAM_CHANNEL=

# --- MAX (если не нужен — оставьте пустым) ---
MAX_TOKEN=
MAX_CHANNEL_ID=